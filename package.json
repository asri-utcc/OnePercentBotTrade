{
  "name": "onepercentbottrade",
  "version": "1.6.0",
  "description": "Binance Spot Maker-only Trading Bot with S1 signal (BOD Keltner Channel)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "backtest": "node scripts/run-backtest.js",
    "cleanup:orphans": "node scripts/cleanup-orphan.js",
    "cleanup:orphans:dexe": "node scripts/cleanup-orphan.js DEXEUSDT",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop onepercentbot",
    "pm2:restart": "pm2 restart onepercentbot",
    "pm2:reload": "pm2 reload onepercentbot",
    "pm2:delete": "pm2 delete onepercentbot",
    "pm2:logs": "pm2 logs onepercentbot",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/dps\\.live\\.test\\.js$"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.17.3",
    "mongoose": "^8.0.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1"
  }
}
