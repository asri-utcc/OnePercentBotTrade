# ─── Server ────────────────────────────────────────────
PORT=6015
# Host to bind: '127.0.0.1' = localhost only (ปลอดภัย)
#               '0.0.0.0'   = all interfaces (ต้องการถ้า forward port ผ่าน router)
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ─── Session / Auth ────────────────────────────────────
# เปลี่ยนเป็นค่าสุ่มยาวๆ อย่างน้อย 64 ตัวอักษร
SESSION_SECRET=replace-with-random-64-char-string-xxxxxxxxxxxxxxxxxxxx

# Password สำหรับ login dashboard (จะถูก hash และเก็บใน DB ตอน setup)
DASHBOARD_PASSWORD=

# ─── MongoDB ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/onepercentbottrade

# ─── Encryption ────────────────────────────────────────
# AES-256 key ต้องยาว 32 ตัวอักษร (สร้างด้วย: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
ENCRYPTION_KEY=replace-with-32-char-hex-aes256-key-here

# ─── Binance ───────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = ใช้ BNB จ่าย fee (0.075% maker) | false = จ่าย fee ด้วย asset ที่ซื้อขาย (0.1% maker)
USE_BNB_FOR_FEES=false

# recvWindow สำหรับ signed requests (ms)
BINANCE_RECV_WINDOW=5000

# ─── Trading defaults ──────────────────────────────────
DEFAULT_CAPITAL_PER_TRADE=10
DEFAULT_MAX_TRADES=10
DEFAULT_TP_PERCENT=0.1
DEFAULT_RETRY_TIME_MIN=1
DEFAULT_SYMBOL=BNBUSDT
DEFAULT_TIMEFRAME=5m

# ─── Security (login brute-force protection) ───────────
# จำกัดจำนวนครั้งที่ login ผิดพลาดจาก IP เดียว ภายใน LOGIN_WINDOW_MS
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000    # 15 นาที
LOGIN_LOCKOUT_MS=900000   # lock IP นี้เป็นเวลา 15 นาทีหลัง fail เกินกำหนด
# ─── Admin Monitor (OnePercentBot-Admin) ───────────────
# FIX-2026-08-26: open the bot to phone home + accept admin commands (separate project)
# default OFF — set ADMIN_ENABLED=true to enable
ADMIN_ENABLED=false
# Admin server URL (port 6016 = default)
ADMIN_URL=http://127.0.0.1:6016
# License key (generate with `npm run admin:generate-license` in admin project)
ADMIN_LICENSE_KEY=
# Heartbeat every 5 min + command poll every 1 min
ADMIN_HEARTBEAT_MS=300000
ADMIN_POLL_MS=60000

# ─── Consent (first-run gate) ────────────────────────────
# FIX-2026-08-26 Phase 2c-v2: Hybrid consent flow
#   - true  = require user to Accept/Decline before botManager.start() (default ON)
#   - false = skip gate entirely (bot trades immediately)
CONSENT_ENABLED=true
# Port for the legacy standalone 6017 fallback server (only auto-started if user
# doesn't engage the main-port /consent endpoint within CONSENT_FALLBACK_DELAY_MS)
CONSENT_WEB_PORT=6017
# Bind host for the 6017 server (default 127.0.0.1 — safest)
CONSENT_WEB_HOST=127.0.0.1
# Auto-open default browser when 6017 fallback fires (default ON)
CONSENT_AUTO_OPEN=true
# Local storage path for consent decision
CONSENT_FILE_PATH=
# FIX-2026-08-26 Phase 2c-v2: Hybrid fallback delay (ms)
#   60000  = wait 60s for user to engage 6015 /consent, then auto-start 6017 fallback
#   0      = legacy behavior — start 6017 fallback immediately
#   -1     = never start fallback (6015 only)
CONSENT_FALLBACK_DELAY_MS=60000
