# ══════════════════════════════════════════════════════════════════════════════
#  OnePercentBotTrade — ตัวอย่างไฟล์ตั้งค่า
#  วิธีใช้:   cp .env.example .env      แล้วแก้เฉพาะ STEP 1-3 ข้างล่าง
# ══════════════════════════════════════════════════════════════════════════════
#
#  ┌─ STEP 1 — สร้าง secret 2 ตัว (บังคับ! ถ้าเว้นว่างบอทจะ start ไม่ขึ้น) ─────┐
#  │                                                                            │
#  │   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" │
#  │        → เอาไปใส่ SESSION_SECRET                                           │
#  │                                                                            │
#  │   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" │
#  │        → เอาไปใส่ ENCRYPTION_KEY                                           │
#  │                                                                            │
#  └────────────────────────────────────────────────────────────────────────────┘
#
#  ┌─ STEP 2 — ตั้งค่าเชื่อมต่อ Admin (ขอ license key จากผู้ดูแลระบบ) ─────────┐
#  │   ADMIN_LICENSE_KEY   = คีย์ที่ผู้ดูแลระบบออกให้ (รูปแบบ AAAA-BBBB-CCCC-DDDD)│
#  │   ADMIN_CUSTOMER_TAG  = ชื่อเล่นของคุณ เช่น FAIZ-FRIEND                     │
#  │   ADMIN_URL           = ตั้งค่าไว้ให้แล้ว ไม่ต้องแก้                        │
#  └────────────────────────────────────────────────────────────────────────────┘
#
#  ┌─ STEP 3 — ใส่ Binance API key (หรือใส่ทีหลังผ่านหน้าเว็บ Settings ก็ได้) ──┐
#  │   BINANCE_API_KEY / BINANCE_API_SECRET                                     │
#  │   ⚠ เปิดสิทธิ์ Spot Trading เท่านั้น — ห้ามเปิด Withdrawal เด็ดขาด         │
#  └────────────────────────────────────────────────────────────────────────────┘
#
#  เสร็จแล้วสั่ง:   npm install && npm run pm2:start
#  เช็คว่าต่อ Admin ติดไหม:   npm run pm2:logs | grep "admin-monitor"
#  (ดูตาราง "แก้ปัญหาเชื่อมต่อ Admin ไม่ได้" ท้ายไฟล์นี้)
# ══════════════════════════════════════════════════════════════════════════════


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ STEP 1 — SECRETS (บังคับ — เว้นว่างไม่ได้)                                  │
# └────────────────────────────────────────────────────────────────────────────┘

# ใช้เซ็นคุกกี้ session ของหน้า login
# ⚠ เว้นว่าง = บอทจะ throw "Missing required env: SESSION_SECRET" แล้วดับทันที
# ⚠ ห้ามใช้ค่าเดียวกับเครื่องอื่น — สร้างใหม่ทุกเครื่อง
SESSION_SECRET=

# กุญแจ AES-256-GCM สำหรับเข้ารหัส Binance API key + Telegram token ที่เก็บใน DB
# ⚠ เว้นว่าง = บอทจะ throw "Missing required env: ENCRYPTION_KEY" แล้วดับทันที
# ⚠ ต้องยาว >= 32 ตัวอักษร (แนะนำ hex 64 ตัว = ใช้เป็นกุญแจ 32 bytes ตรงๆ)
# ⚠ ห้ามเปลี่ยนหลังจากบันทึก API key ลง DB แล้ว — ของเก่าจะถอดรหัสไม่ออก
#   (ถ้าจำเป็นต้องเปลี่ยน ให้เข้าหน้า Settings ใส่ API key ใหม่อีกรอบ)
ENCRYPTION_KEY=

# รหัสผ่านสำหรับ login หน้า dashboard
# เว้นว่างได้ — ระบบจะให้ตั้งรหัสผ่านครั้งแรกผ่านหน้าเว็บ (setup wizard)
DASHBOARD_PASSWORD=

# รหัสผ่านชั้นที่ 2 สำหรับ action อันตราย (สร้าง/ลบ/หยุดบอท)
# เว้นว่าง = ใช้ค่าเดียวกับ DASHBOARD_PASSWORD
# ถ้าเว้นว่างทั้งคู่ = ระบบจะบล็อก action อันตรายทั้งหมด (ปลอดภัยไว้ก่อน)
BOT_ACTION_PASSWORD=


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ STEP 2 — ADMIN MONITOR (จุดที่คนตั้งผิดบ่อยที่สุด — อ่านให้ครบ)             │
# └────────────────────────────────────────────────────────────────────────────┘
#
# บอทเป็นฝ่าย "โทรกลับหา" admin เอง (phone-home) — admin ไม่ได้วิ่งเข้ามาหาบอท
# แปลว่าเครื่องคุณ "ต้องออกเน็ตไปที่ ADMIN_URL ได้" แต่ไม่ต้อง forward port อะไรเลย
#
#   บอทเครื่องคุณ  ──── heartbeat ทุก 5 นาที ────►  Admin :6016
#
# ทดสอบว่าเครื่องคุณคุยกับ admin ได้ไหม (ต้องได้ status 200 หรือ 401 กลับมา ไม่ใช่ timeout):
#   curl -i http://gigi.thaiddns.com:6016/health

# true = เปิดการเชื่อมต่อ Admin (ค่าเริ่มต้นของชุดแจกจ่ายนี้)
# false = ปิดสนิท ไม่ส่งข้อมูลอะไรออกเลย — แต่ก็จะไม่ขึ้นในหน้า Admin เช่นกัน
ADMIN_ENABLED=true

# ⚠⚠ ที่อยู่เซิร์ฟเวอร์ Admin — สาเหตุอันดับ 1 ที่คนต่อไม่ติดคือแก้บรรทัดนี้ผิด ⚠⚠
# ห้ามเปลี่ยนเป็น 127.0.0.1 หรือ localhost เด็ดขาด (นั่นคือเครื่องตัวเอง ไม่ใช่ Admin)
# ถ้าตั้งผิด log จะขึ้น: "admin-monitor: heartbeat failed ... ECONNREFUSED 127.0.0.1:6016"
ADMIN_URL=http://gigi.thaiddns.com:6016

# ⚠⚠ License key — ต้องขอจากผู้ดูแลระบบเท่านั้น มั่วเองไม่ได้ ⚠⚠
# Admin จะตอบ 401 invalid_license ถ้าคีย์ไม่มีอยู่จริงในฐานข้อมูลของเขา
# เว้นว่าง = log จะขึ้น "ADMIN_LICENSE_KEY not set, heartbeat disabled" และไม่ขึ้นในหน้า Admin
ADMIN_LICENSE_KEY=

# ป้ายชื่อลูกค้า — โชว์ในหน้า Admin เพื่อให้รู้ว่าเครื่องนี้เป็นของใคร
# ตัวอย่าง: FAIZ-FRIEND, ACME-TRADING-01
ADMIN_CUSTOMER_TAG=

# URL ของบอทตัวเอง (Admin ใช้ดึง snapshot ราย 5 นาที)
# ⚠ ต้องให้ port ตรงกับ PORT ข้างล่างเสมอ — ถ้าเปลี่ยน PORT ต้องแก้บรรทัดนี้ด้วย
# ถ้าไม่ตรง: เครื่องจะขึ้นออนไลน์ในหน้า Admin แต่ไม่มีข้อมูลบอท/ไม้ที่ถืออยู่ (พังเงียบๆ)
ADMIN_BOT_URL=http://127.0.0.1:6015

# จังหวะการสื่อสารกับ Admin (หน่วย ms) — ปกติไม่ต้องแก้
ADMIN_HEARTBEAT_MS=300000
ADMIN_POLL_MS=60000
ADMIN_SNAPSHOT_MS=300000
ADMIN_LICENSE_REVALIDATE_MS=3600000

# ระบบแชทกับผู้ดูแล (หน่วย ms) — ปกติไม่ต้องแก้
ADMIN_CHAT_OUTBOX_MS=3000
ADMIN_CHAT_INBOX_MS=5000
ADMIN_CHAT_OUTBOX_BATCH=10

# กุญแจ HMAC สำหรับตรวจลายเซ็นคำสั่งที่ Admin ส่งมา
# เว้นว่างได้ — ระบบจะคำนวณเองจาก ADMIN_LICENSE_KEY โดยอัตโนมัติ
# ⚠ ตัวนี้ไม่เกี่ยวกับ heartbeat — ต่อ Admin ไม่ติด ไม่ได้เกิดจากบรรทัดนี้
# ตั้งเฉพาะกรณีคุณรัน Admin เอง แล้วอยากใช้ค่าเดียวกับ JWT_SECRET ของฝั่ง Admin
ADMIN_COMMAND_HMAC_SECRET=

# ไฟล์เก็บรหัสประจำเครื่อง (machineId) ที่ใช้แยกเครื่องในหน้า Admin
# เว้นว่าง = ./data/admin-machine-id.txt
# ⚠ ถ้ารันบอท 2 ตัวบนเครื่องเดียวกัน "ต้อง" ตั้งคนละไฟล์ ไม่งั้น Admin จะเห็นเป็นเครื่องเดียว
#   ตัวอย่าง: MACHINE_ID_FILE=./data/faiz-machine-id.txt
MACHINE_ID_FILE=

# การอัปเดตอัตโนมัติ — ปกติไม่ต้องแก้
ADMIN_UPDATE_CHECK_MS=86400000
ADMIN_UPDATE_CHANNEL=stable


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ STEP 3 — BINANCE                                                           │
# └────────────────────────────────────────────────────────────────────────────┘
# สร้างที่ Binance → API Management
# ✅ เปิด: Enable Spot & Margin Trading
# ❌ ปิด: Enable Withdrawals (ห้ามเปิดเด็ดขาด)
# แนะนำให้ล็อก IP ของเครื่องที่รันบอทไว้ด้วย
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = จ่ายค่าธรรมเนียมด้วย BNB (maker 0.075%) — ต้องมี BNB ค้างในบัญชี
# false = จ่ายด้วยเหรียญที่เทรด (maker 0.1%)
USE_BNB_FOR_FEES=false

# recvWindow ของ signed request (ms)
# ⚠ ถ้าเจอ error -1021 "Timestamp for this request is outside recvWindow"
#   แปลว่านาฬิกาเครื่องคลาดเคลื่อน → Windows: w32tm /resync | Linux: sudo ntpdate pool.ntp.org
BINANCE_RECV_WINDOW=5000


# ══════════════════════════════════════════════════════════════════════════════
#  ส่วนที่เหลือ = ค่าเริ่มต้นที่ใช้ได้เลย ไม่ต้องแก้ก็ได้
# ══════════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
# พอร์ตหน้าเว็บ dashboard (ถ้าเปลี่ยน อย่าลืมแก้ ADMIN_BOT_URL ข้างบนให้ตรงกัน)
PORT=6015

# 127.0.0.1 = เปิดจากเครื่องตัวเองเท่านั้น (ปลอดภัยที่สุด — แนะนำ)
# 0.0.0.0   = เปิดทุก interface (ใช้เมื่อต้องการเข้าหน้าเว็บจากมือถือ/เครื่องอื่น
#             หรือ forward port ผ่าน router — ต้องตั้ง DASHBOARD_PASSWORD ให้แข็งแรง)
# ℹ หมายเหตุ: ค่านี้ "ไม่เกี่ยวกับ" การต่อ Admin — บอทเป็นฝ่ายโทรออกไปหา Admin เอง
#   ต่อ Admin ไม่ติดแล้วมาแก้ HOST=0.0.0.0 จะไม่ช่วยอะไร
HOST=127.0.0.1

# production = แนะนำสำหรับใช้งานจริง | development = log ละเอียดกว่า สำหรับ debug
NODE_ENV=production

# trace | debug | info | warn | error
LOG_LEVEL=info

# ชื่อคุกกี้ session — เว้นว่าง = connect.sid
# ⚠ ถ้ารันบอท 2 ตัวบนเครื่อง/โดเมนเดียวกัน "ต้อง" ตั้งคนละชื่อ
#   (คุกกี้ผูกกับโดเมน ไม่ได้แยกตามพอร์ต — ล็อกอินตัวหนึ่งจะเตะอีกตัวหลุด)
#   ตัวอย่าง: SESSION_COOKIE_NAME=connect.sid.faiz
SESSION_COOKIE_NAME=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# ⚠ ถ้ารันบอท 2 ตัวบนเครื่องเดียวกัน ต้องใช้ชื่อฐานข้อมูลคนละชื่อ
#   ตัวอย่าง: mongodb://127.0.0.1:27017/onepercentbottrade_faiz
MONGODB_URI=mongodb://127.0.0.1:27017/onepercentbottrade

# ─── ค่าเริ่มต้นของบอทใหม่ (แก้ทีหลังในหน้าเว็บได้) ───────────────────────────
DEFAULT_CAPITAL_PER_TRADE=10
DEFAULT_MAX_TRADES=10
DEFAULT_TP_PERCENT=0.1
DEFAULT_RETRY_TIME_MIN=1
DEFAULT_RETRY_MAX=1
DEFAULT_SYMBOL=BNBUSDT
DEFAULT_TIMEFRAME=5m

# ─── ป้องกัน brute-force หน้า login ───────────────────────────────────────────
# จำนวนครั้งที่ยอมให้ login ผิดจาก IP เดียวกัน ภายใน LOGIN_WINDOW_MS
LOGIN_MAX_ATTEMPTS=10
# ช่วงเวลานับ (ms) — 900000 = 15 นาที
LOGIN_WINDOW_MS=900000
# ระยะเวลาล็อก IP หลังผิดเกินกำหนด (ms) — 900000 = 15 นาที
LOGIN_LOCKOUT_MS=900000

# ─── หน้ายินยอม (Consent) ตอนเปิดบอทครั้งแรก ─────────────────────────────────
# true  = ต้องกด Accept/Decline ก่อนบอทเริ่มเทรด (ค่าเริ่มต้น)
# false = ข้ามหน้านี้ไปเลย
CONSENT_ENABLED=true

# เวอร์ชันข้อความยินยอม (ใช้เก็บ audit เฉยๆ)
CONSENT_VERSION=1

# หน้าสำรองที่เด้งให้เอง ถ้าผู้ใช้ไม่กดที่ http://127.0.0.1:6015/consent ภายในเวลาที่กำหนด
# ⚠ รันบอท 2 ตัวบนเครื่องเดียวกันต้องตั้งคนละพอร์ต
CONSENT_WEB_PORT=6017
CONSENT_WEB_HOST=127.0.0.1
CONSENT_AUTO_OPEN=true

# 60000 = รอ 60 วิให้กดที่พอร์ตหลักก่อน แล้วค่อยเปิดหน้าสำรอง
# 0     = เปิดหน้าสำรองทันที
# -1    = ไม่เปิดหน้าสำรองเลย
CONSENT_FALLBACK_DELAY_MS=60000

# ที่เก็บผลการกดยินยอม — เว้นว่าง = ~/.onepercentbot-consent.json
# ⚠ ถ้ารันบอท 2 ตัวบนเครื่องเดียวกัน "ต้อง" ตั้งคนละไฟล์
#   ไม่งั้นตัวที่สองจะอ่านผลของตัวแรก แล้วไม่ส่งสถานะยินยอมของตัวเองไปที่ Admin
#   ตัวอย่าง: CONSENT_FILE_PATH=./data/faiz-consent.json
CONSENT_FILE_PATH=


# ══════════════════════════════════════════════════════════════════════════════
#  แก้ปัญหา "ต่อ Admin ไม่ติด" — ดู log ก่อนเสมอ
#  คำสั่ง:  npm run pm2:logs | grep -E "admin-monitor|license-gate|consent"
# ══════════════════════════════════════════════════════════════════════════════
#
#  ── ต่อสำเร็จ จะเห็นประมาณนี้ ────────────────────────────────────────────────
#     admin-monitor: heartbeat sent
#     admin-monitor: command listener started
#     license-gate: validated
#
#  ── ข้อความ error → สาเหตุ → วิธีแก้ ─────────────────────────────────────────
#
#  "admin-monitor: disabled (set ADMIN_ENABLED=true to enable)"
#      → ADMIN_ENABLED ไม่ใช่ true          แก้: ADMIN_ENABLED=true
#
#  "ADMIN_LICENSE_KEY not set, heartbeat disabled"
#      → ยังไม่ได้ใส่ license key           แก้: ขอคีย์จากผู้ดูแลระบบมาใส่
#
#  "heartbeat failed ... ECONNREFUSED 127.0.0.1:6016"
#      → ADMIN_URL ชี้ผิดไปที่เครื่องตัวเอง  แก้: ADMIN_URL=http://gigi.thaiddns.com:6016
#
#  "heartbeat failed ... ETIMEDOUT" หรือค้างนาน
#      → ไฟร์วอลล์/เน็ตบล็อกขาออกพอร์ต 6016 หรือ Admin ปิดอยู่
#        แก้: ทดสอบ  curl -i http://gigi.thaiddns.com:6016/health  แล้วแจ้งผู้ดูแลระบบ
#
#  "heartbeat failed ... status: 401"
#      → license key ผิด/ถูกยกเลิก/หมดอายุ   แก้: ขอคีย์ใหม่จากผู้ดูแลระบบ
#
#  "heartbeat failed ... status: 403"  (machine_limit_exceeded)
#      → ใช้คีย์เดียวเกินจำนวนเครื่องที่อนุญาต
#        แก้: ขอผู้ดูแลระบบเพิ่ม max-machines หรือขอคีย์แยกอีกใบ
#
#  "consent: declined — botManager.start() SKIPPED"
#      → กด Decline ในหน้ายินยอมไว้ บอทจะไม่เทรดและไม่ส่ง heartbeat
#        แก้: เปิด http://127.0.0.1:6015/consent แล้วกด Accept
#             (หรือสั่ง npm run consent:reset เพื่อล้างค่าเดิม)
#
#  "phoneHomeMonitor: phone-home DOWN — bot will pause new positions"
#      → ติดต่อ Admin ไม่ได้ติดต่อกันเกิน 48 ชม. บอทจะหยุดเปิดไม้ใหม่
#        แก้: ไล่แก้ตามข้อข้างบนให้ heartbeat กลับมาก่อน
#
#  ── ขึ้นในหน้า Admin แล้ว แต่ไม่มีข้อมูลบอท/ไม้ที่ถืออยู่ ────────────────────
#     "admin-monitor: snapshot send failed"
#      → ADMIN_BOT_URL พอร์ตไม่ตรงกับ PORT   แก้: ตั้งให้ตรงกัน (ทั้งคู่ 6015)
#
#  ── รันบอท 2 ตัวบนเครื่องเดียว แต่ Admin เห็นแค่เครื่องเดียว ────────────────
#      → machineId ชนกัน  แก้: ตั้ง MACHINE_ID_FILE + MONGODB_URI + PORT +
#        CONSENT_WEB_PORT + CONSENT_FILE_PATH + SESSION_COOKIE_NAME แยกกันทุกตัว
#
# ══════════════════════════════════════════════════════════════════════════════
